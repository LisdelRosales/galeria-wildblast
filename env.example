# Database
DATABASE_URL="postgresql://username:password@localhost:5432/galeria_wildblast"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Supabase (Storage)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# Plausible Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="your-domain.com"
NEXT_PUBLIC_PLAUSIBLE_SCRIPT="https://plausible.io/js/script.js"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Galería Wild Blast"
NEXT_PUBLIC_YOUTUBE_CHANNEL="https://www.youtube.com/@your-channel"

# Watermark Configuration
WATERMARK_TEXT="© Wild Blast"
WATERMARK_OPACITY="0.3"
WATERMARK_FONT_SIZE="24"

# Download Configuration
DOWNLOAD_EXPIRY_HOURS="24"
MAX_DOWNLOADS_PER_HOUR="10"
